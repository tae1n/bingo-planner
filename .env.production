POSTGRES_USER=bingo
POSTGRES_PASSWORD=<변경필요>
POSTGRES_DB=bingo_planner
DATABASE_URL=postgresql://bingo:<변경필요>@postgres:5432/bingo_planner?schema=public
JWT_SECRET=<변경필요>
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# DuckDNS에서 발급받은 서브도메인 (예: bingo-planner)
DOMAIN=<서브도메인>.duckdns.org
DUCKDNS_TOKEN=<DuckDNS_토큰>

CORS_ORIGIN=https://<서브도메인>.duckdns.org
NEXT_PUBLIC_API_URL=https://<서브도메인>.duckdns.org/api/v1
