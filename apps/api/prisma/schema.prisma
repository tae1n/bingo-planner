generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  password        String
  name            String   @db.VarChar(50)
  nickname        String   @unique @db.VarChar(30)
  nationality     String?  @db.VarChar(50)
  job             String?  @db.VarChar(100)
  phone           String?  @db.VarChar(20)
  profileImageUrl String?  @db.VarChar(500)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  boards          BingoBoard[]
  boardMemberships BoardMember[]
  progressRecords ProgressRecord[]
  comments        Comment[]
  notifications   Notification[]

  @@map("users")
}

model BingoBoard {
  id          Int      @id @default(autoincrement())
  ownerId     Int
  title       String   @db.VarChar(100)
  description String?  @db.Text
  size        Int      @default(3) @db.SmallInt
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  status      String   @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User          @relation(fields: [ownerId], references: [id])
  members BoardMember[]
  items   BingoItem[]

  @@map("bingo_boards")
}

model BoardMember {
  id        Int      @id @default(autoincrement())
  boardId   Int
  userId    Int
  role      String   @db.VarChar(20) // VIEWER | REVIEWER
  status    String   @default("PENDING") @db.VarChar(20) // PENDING | ACCEPTED | REJECTED
  createdAt DateTime @default(now())

  board BingoBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id])

  @@unique([boardId, userId])
  @@map("board_members")
}

model BingoItem {
  id            Int       @id @default(autoincrement())
  boardId       Int
  title         String    @db.VarChar(200)
  description   String?   @db.Text
  position      Int       @db.SmallInt
  color         String?   @db.VarChar(7)
  deadline      DateTime? @db.Date
  conditionType String    @default("ONCE") @db.VarChar(20)
  targetCount   Int       @default(1)
  isAchieved    Boolean   @default(false)
  achievedAt    DateTime?
  achievedBy    Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  board       BingoBoard   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  checkpoints Checkpoint[]

  @@unique([boardId, position])
  @@map("bingo_items")
}

model Checkpoint {
  id              Int       @id @default(autoincrement())
  bingoItemId     Int
  title           String    @db.VarChar(200)
  description     String?   @db.Text
  deadline        DateTime? @db.Date
  sortOrder       Int       @default(0) @db.SmallInt
  isAchieved      Boolean   @default(false)
  achievedAt      DateTime?
  achievedBy      Int?
  isAutoGenerated Boolean   @default(false)
  targetCount     Int       @default(1)
  achievedCount   Int       @default(0)
  startDate       DateTime? @db.Date
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bingoItem       BingoItem        @relation(fields: [bingoItemId], references: [id], onDelete: Cascade)
  progressRecords ProgressRecord[]

  @@map("checkpoints")
}

model ProgressRecord {
  id           Int       @id @default(autoincrement())
  checkpointId Int
  authorId     Int
  content      String?   @db.Text
  imageUrls    Json      @default("[]")
  recordedAt   DateTime  @db.Date
  status       String    @default("PENDING") @db.VarChar(20)
  reviewedBy   Int?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  checkpoint Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id])

  @@map("progress_records")
}

model Comment {
  id         Int      @id @default(autoincrement())
  authorId   Int
  targetType String   @db.VarChar(30) // BINGO_ITEM | CHECKPOINT | PROGRESS_RECORD
  targetId   Int
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([targetType, targetId])
  @@map("comments")
}

model Notification {
  id         Int      @id @default(autoincrement())
  userId     Int
  type       String   @db.VarChar(30) // INVITE | ACHIEVEMENT | COMMENT | DEADLINE
  targetType String   @db.VarChar(30)
  targetId   Int
  message    String   @db.VarChar(500)
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}
